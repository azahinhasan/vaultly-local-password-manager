{
  "expo": {
    "name": "password-manager-mobile",
    "slug": "password-manager-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lock.png",
    "scheme": "passwordmanagermobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDEEE3",
        "foregroundImage": "./assets/images/lock.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.azahinhasan.passwordmanagermobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lock.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cba802ba-e836-40b8-b9c2-3b28a0606751"
      }
    },
    "owner": "azahinhasan"
  }
}
